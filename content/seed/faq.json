     "src": "faq",
     "items": [
      {
       "q": "Who can join?",
       "a": "Any SCU undergraduate, graduate student, faculty or staff member."
      },
      {
       "q": "Do I need to be a bio or pharma major?",
       "a": "No. CLIP is for every major, from bioengineering and chemistry to computer science and business."
      },
      {
       "q": "What makes someone an active member?",
       "a": "Coming to at least two CLIP events a quarter. Meetings, seminars and off-campus visits all count."
      },
      {
       "q": "When do you meet?",
       "a": "General meetings are weekly: [day, time, room]."
      },
      {
       "q": "How do I join the board?",
       "a": "Officers are picked by application each spring, in week 4 of spring quarter."
      },
      {
       "q": "Can I suggest a speaker or event?",
       "a": "Yes. Email connectingleaders@scu.edu or tell a board member at a meeting."
      }
     ],
