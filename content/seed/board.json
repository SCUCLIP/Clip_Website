        {
          "id": "eroles1lst",
          "type": "list",
          "d": [0, 125.8, 1180, 424],
          "m": [0, 111, 326, 864],
          "z": 2,
          "kind": "roles",
          "items": [
            {
              "title": "President",
              "text": "Represents CLIP on campus and off, oversees events and projects, keeps in touch with industry leaders and builds partnerships with Bay Area organizations."
            },
            {
              "title": "Vice President",
              "text": "Represents CLIP, works with industry leaders and other SCU groups, and keeps budgets, registration forms, event posts and emails on time."
            },
            {
              "title": "Secretary",
              "text": "Takes meeting notes, books rooms, keeps the club calendar and agendas, and tracks attendance."
            },
            {
              "title": "Treasurer",
              "text": "Files funding requests, keeps the club's financial records, finds new funding and handles budget and reimbursement forms."
            },
            {
              "title": "Marketing and Outreach",
              "text": "Designs posters, sends the weekly email, runs promotion and sets up events with other clubs and departments."
            }
          ]
        },
        {
          "id": "eroles1nte",
