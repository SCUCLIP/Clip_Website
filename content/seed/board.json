     "id": "eroles1lst",
     "type": "list",
     "src": "roles",
     "items": [
      {
       "title": "President",
       "duties": "Represents CLIP on campus and off, oversees events and projects, keeps in touch with industry leaders and builds partnerships with Bay Area organizations."
      },
      {
       "title": "Vice President",
       "duties": "Represents CLIP, works with industry leaders and other SCU groups, and keeps budgets, registration forms, event posts and emails on time."
      },
      {
       "title": "Secretary",
       "duties": "Takes meeting notes, books rooms, keeps the club calendar and agendas, and tracks attendance."
      },
      {
       "title": "Treasurer",
       "duties": "Files funding requests, keeps the club's financial records, finds new funding and handles budget and reimbursement forms."
      },
      {
       "title": "Marketing and Outreach",
       "duties": "Designs posters, sends the weekly email, runs promotion and sets up events with other clubs and departments."
      }
     ],
