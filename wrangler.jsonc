// Cloudflare Worker for the CLIP website (public site + editor).
// Security rules live in CLAUDE.md and docs/THREAT-MODEL.md. In short:
// - Never add a variable here that turns on local mode. `npm run dev` passes it on the command line.
// - Secrets (TURNSTILE_SECRET) go in with `wrangler secret put`, never in this file.
// - Before going live, follow docs/GO-LIVE.md (real D1 id, Access, Turnstile).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clip-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Only the two custom domains below. No *.workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "scuclip.com", "custom_domain": true },
    { "pattern": "admin.scuclip.com", "custom_domain": true }
  ],

  // Don't send wrangler usage data to Cloudflare from this project.
  "send_metrics": false,

  // Every request runs the Worker first, so security headers and host rules apply to files too.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clip-website",
      // Placeholder. Replace with the id from `wrangler d1 create clip-website` when going live (docs/GO-LIVE.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "clip-website-photos" }
  ],

  "vars": {
    "PUBLIC_HOST": "scuclip.com",
    "ADMIN_HOST": "admin.scuclip.com",
    // Cloudflare Access: the team domain (<team>.cloudflareaccess.com) and the editor app's Audience (AUD) tag.
    // Left empty, the editor refuses every request off localhost.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Turnstile site key (public). The secret is TURNSTILE_SECRET, set with `wrangler secret put`.
    // Left empty, the sign-up forms refuse every request off localhost.
    "TURNSTILE_SITE_KEY": ""
  }
}
